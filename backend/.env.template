# Copy to .env. A commented-out line is optional: either it shows the default, or it names a
# feature that stays off until it is set.
#
# Keep values in single quotes. dotenv substitutes $VAR in unquoted and double-quoted values, and
# an argon2 hash is full of '$' -- unquoted, MORIED_USER_HASH would be silently corrupted.

# Server
MORIED_LISTEN='localhost:3030'
# The path moried is served under. Must start and end with '/'.
MORIED_ROOT_PATH='/'
# The one browser origin allowed to call the API: wherever the frontend is served from.
MORIED_ORIGIN_ALLOWED='http://localhost:8080'
# Log filter, such as 'moried=debug,tower_http=debug'. Unset, nothing is logged.
# RUST_LOG='moried=info'

# Storage
MORIED_GIT_DIR='notes'
MORIED_IMAGE_CACHE_DIR='cache'
# How long a read waits for the file-listing cache to catch up with HEAD before serving what it
# already has.
# MORIED_CACHE_SYNC_DEADLINE_MS='3000'

# Authentication
MORIED_USER_NAME='USERNAME'
MORIED_USER_EMAIL='user@example.com'
MORIED_USER_HASH='$argon2i$v=19$m=4096,t=3,p=1$MUZxK1p5Y3RrQmpVazM5SFduelZCakxhV0dqSXJEMy8$XcE1aipcYOUd7gIxh8f2+RRLQmlNT96cLyguIZqE128'
# Signs web sessions and MCP tokens alike, so rotating it ends both.
MORIED_SECRET='SERVERSECRETKEY'
MORIED_SESSION_EXPIRY_MINUTES='360'

# OpenAI, for task assessment and AI actions. Semantic search below reuses the API key.
MORIED_OPENAI_API_KEY='sk-your-openai-api-key-here'
MORIED_OPENAI_MODEL='gpt-5-mini'
MORIED_OPENAI_CACHE_HOURS='24'

# Search
MORIED_SEARCH_INDEX_DIR='search-index'
# Search indexes and ranking stay local. This opt-in permits Markdown passages, Semantic/Hybrid
# queries, and supported image pixels to be sent to OpenAI for disposable derived artifacts.
MORIED_SEMANTIC_SEARCH_ENABLED='false'
MORIED_OPENAI_EMBEDDING_MODEL='text-embedding-3-small'
MORIED_OPENAI_EMBEDDING_DIMENSIONS='1536'
# Required to index images; it is deliberately not inherited from MORIED_OPENAI_MODEL.
# MORIED_OPENAI_VISION_MODEL='your-vision-capable-model'

# Calendar subscriptions
# How long a fetched iCal feed is served from the cache before it is revalidated.
# MORIED_ICAL_CACHE_MINUTES='60'

# MCP server
# The origin clients reach this server at, without a trailing slash. Setting it turns on the MCP
# server and the OAuth endpoints it needs; leaving it unset turns both off entirely.
# MORIED_PUBLIC_URL='https://notes.example.com'
# Extra Host values the MCP endpoint accepts, comma-separated. Only needed when a reverse proxy
# rewrites Host to an internal name; the public URL's own authority is always allowed.
# MORIED_MCP_ALLOWED_HOSTS='notes.internal,notes.internal:3030'
