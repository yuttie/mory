# Copy to .env next to compose.yaml. A commented-out line is optional and shows the default.
#
# This configures the host. The containers read env.moried.list and env.mory.list, which take
# the variables in backend/.env.template and frontend/.env.template, unquoted.

# Host
# moried runs as this user and group, which must own the three directories below: `id -u` and
# `id -g`.
MORY_UID='1000'
MORY_GID='1000'
# The notes' Git repository.
MORY_REPO_DIR='/srv/mory/notes.git'
# Images converted to WebP. Disposable.
MORY_CACHE_DIR='/srv/mory/cache'
# moried's working directory: cache.sqlite, and the search index while MORIED_SEARCH_INDEX_DIR is
# relative. Disposable, but rebuilding takes a while, and with semantic search on it sends every
# note to OpenAI again.
MORY_HOME_DIR='/srv/mory/home'
# Where each is published on the host, as IP:port.
# MORY_BACKEND_ADDRESS='127.0.0.1:3030'
# MORY_FRONTEND_ADDRESS='127.0.0.1:8080'
