{
    "definitions": {
        "event-weekday": {
            "description": "A weekday, optionally prefixed with an ordinal selecting it within the period: 3wed is the third Wednesday, -1fri the last Friday. Ordinals mean nothing under freq: weekly.",
            "type": "string",
            "pattern": "^-?[0-9]*(sun|mon|tue|wed|thu|fri|sat)$"
        },
        "event-repeat": {
            "description": "A recurrence rule. Absent tz means the reader's own timezone; a name is required rather than an offset because a zone maps a date to an offset and a series crosses DST boundaries.",
            "type": "object",
            "properties": {
                "freq": { "enum": ["daily", "weekly", "monthly", "yearly"] },
                "interval": { "type": "integer", "minimum": 1 },
                "byday": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-weekday" }
                },
                "bymonthday": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": -31, "maximum": 31 }
                },
                "bymonth": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1, "maximum": 12 }
                },
                "wkst": { "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"] },
                "tz": { "type": "string" },
                "until": { "type": "string" },
                "count": { "type": "integer", "minimum": 1 }
            },
            "required": ["freq"],
            "not": { "required": ["until", "count"] },
            "additionalProperties": false
        },
        "event-alarm": {
            "description": "When one alarm rings. An offset from the start, [+-]N unit (-10m, +1h, -2 days), with the units w d h m s or weeks days hours minutes seconds; or a time on the start's day, [[+-]N d|w ]HH:MM (09:00, -1d 18:00). The sign is required unless N is 0, so 10m is not read as ten minutes after. d and w take whole numbers and count calendar days; h, m and s count elapsed time. No alarm is more than a year from its start.",
            "type": "string",
            "pattern": "^\\s*(?:(?:[+-][0-9]+|0+) *(?:weeks?|days?|w|d)|(?:[+-][0-9]+(?:\\.[0-9]+)?|0+(?:\\.0+)?) *(?:hours?|minutes?|seconds?|h|m|s)|(?:(?:[+-][0-9]+|0+) *(?:weeks?|days?|w|d) +)?(?:[01][0-9]|2[0-3]):[0-5][0-9])\\s*$"
        },
        "event-alarms": {
            "description": "When an event or occurrence rings: a list of alarms, or one alone. An empty list silences it, and an empty value is not set, so it takes the category's alarms, then the global ones in .mory/calendars.yaml.",
            "oneOf": [
                { "type": "null" },
                { "$ref": "#/definitions/event-alarm" },
                {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-alarm" }
                }
            ]
        },
        "event-ical": {
            "description": "Where an imported event came from. recurrence_id narrows the claim to one occurrence; without it the note shadows the whole series.",
            "type": "object",
            "properties": {
                "calendar": { "type": "string" },
                "uid": { "type": "string" },
                "recurrence_id": { "type": "string" }
            },
            "required": ["uid"]
        },
        "event-occurrence": {
            "description": "One occurrence. With at, it changes the occurrence the rule generates at that time; with its own start, it is an occurrence the rule does not generate.",
            "type": "object",
            "properties": {
                "at": { "type": "string" },
                "start": { "type": "string" },
                "end": { "type": "string" },
                "finished": { "type": "boolean" },
                "color": { "type": "string" },
                "note": { "type": "string" },
                "name": { "type": "string" },
                "location": { "type": "string" },
                "url": { "type": "string" },
                "alarms": { "$ref": "#/definitions/event-alarms" }
            }
        },
        "event-override": {
            "allOf": [
                { "$ref": "#/definitions/event-occurrence" },
                { "required": ["at"] }
            ]
        },
        "event-instance": {
            "allOf": [
                { "$ref": "#/definitions/event-occurrence" },
                { "required": ["start"] }
            ]
        },
        "event": {
            "description": "An event is a base occurrence (start), a list of occurrences (instances, or its older spelling times), or a rule (repeat) with adjustments to what it generates.",
            "type": "object",
            "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" },
                "finished": { "type": "boolean" },
                "color": { "type": "string" },
                "note": { "type": "string" },
                "name": { "type": "string" },
                "location": { "type": "string" },
                "url": { "type": "string" },
                "alarms": { "$ref": "#/definitions/event-alarms" },
                "category": {
                    "description": "The id of a category under categories: in .mory/calendars.yaml, which supplies a default color, a name template and alarms. A nested id such as meeting/1on1 takes whatever it does not set from meeting.",
                    "type": "string"
                },
                "repeat": { "$ref": "#/definitions/event-repeat" },
                "exclusions": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "overrides": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-override" }
                },
                "instances": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-instance" }
                },
                "times": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-instance" }
                },
                "ical": { "$ref": "#/definitions/event-ical" }
            },
            "anyOf": [
                { "required": ["start"] },
                { "required": ["instances"] },
                { "required": ["times"] }
            ],
            "dependencies": {
                "repeat": ["start"],
                "exclusions": ["repeat"],
                "overrides": ["repeat"]
            }
        },
        "backlog-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "backlog" }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "todo-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "todo" }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "in-progress-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "in_progress" }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "waiting-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "waiting" },
                "waiting_for": { "type": "string" },
                "expected_by": { "type": "string" },
                "contact": { "type": "string" },
                "follow_up_at": { "type": "string" }
            },
            "required": ["kind", "waiting_for"],
            "additionalProperties": false
        },
        "blocked-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "blocked" },
                "blocked_by": { "type": "string" }
            },
            "required": ["kind", "blocked_by"],
            "additionalProperties": false
        },
        "on-hold-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "on_hold" },
                "hold_reason": { "type": "string" },
                "review_at": { "type": "string" }
            },
            "required": ["kind", "hold_reason"],
            "additionalProperties": false
        },
        "done-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "done" },
                "completed_at": { "type": "string" },
                "completion_note": { "type": "string" }
            },
            "required": ["kind", "completed_at"],
            "additionalProperties": false
        },
        "canceled-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "canceled" },
                "canceled_at": { "type": "string" },
                "cancel_reason": { "type": "string" }
            },
            "required": ["kind", "canceled_at", "cancel_reason"],
            "additionalProperties": false
        },
        "task-status": {
            "oneOf": [
                { "$ref": "#/definitions/backlog-status" },
                { "$ref": "#/definitions/todo-status" },
                { "$ref": "#/definitions/in-progress-status" },
                { "$ref": "#/definitions/waiting-status" },
                { "$ref": "#/definitions/blocked-status" },
                { "$ref": "#/definitions/on-hold-status" },
                { "$ref": "#/definitions/done-status" },
                { "$ref": "#/definitions/canceled-status" }
            ]
        },
        "task": {
            "type": "object",
            "properties": {
                "status": { "$ref": "#/definitions/task-status" },
                "progress": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "importance": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                },
                "urgency": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                },
                "start_at": { "type": "string" },
                "due_by": { "type": "string" },
                "deadline": { "type": "string" },
                "scheduled_dates": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "alarms": {
                    "description": "When due_by and deadline ring. Without these, they ring as .mory/calendars.yaml says, which is not at all unless it says so.",
                    "oneOf": [
                        { "type": "null" },
                        {
                            "type": "object",
                            "properties": {
                                "due_by": { "$ref": "#/definitions/event-alarms" },
                                "deadline": { "$ref": "#/definitions/event-alarms" }
                            },
                            "additionalProperties": false
                        }
                    ]
                }
            },
            "required": ["status", "progress", "importance", "urgency", "scheduled_dates"],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "created_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}[+-]\\d{2}:\\d{2}$"
        },
        "tags": {
            "oneOf": [
                { "type": "null" },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "events": {
            "oneOf": [
                { "type": "null" },
                {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/event" }
                }
            ]
        },
        "task": {
            "oneOf": [
                { "type": "null" },
                { "$ref": "#/definitions/task" }
            ]
        }
    }
}
