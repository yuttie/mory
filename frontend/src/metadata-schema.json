{
    "definitions": {
        "event-weekday": {
            "description": "A weekday, optionally prefixed with an ordinal selecting it within the period: 3wed is the third Wednesday, -1fri the last Friday. Ordinals mean nothing under freq: weekly.",
            "type": "string",
            "pattern": "^-?[0-9]*(sun|mon|tue|wed|thu|fri|sat)$"
        },
        "event-repeat": {
            "description": "A recurrence rule. Absent tz means the reader's own timezone; a name is required rather than an offset because a zone maps a date to an offset and a series crosses DST boundaries.",
            "type": "object",
            "properties": {
                "freq": { "enum": ["daily", "weekly", "monthly", "yearly"] },
                "interval": { "type": "integer", "minimum": 1 },
                "byday": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-weekday" }
                },
                "bymonthday": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": -31, "maximum": 31 }
                },
                "bymonth": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1, "maximum": 12 }
                },
                "wkst": { "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"] },
                "tz": { "type": "string" },
                "until": { "type": "string" },
                "count": { "type": "integer", "minimum": 1 }
            },
            "required": ["freq"],
            "not": { "required": ["until", "count"] },
            "additionalProperties": false
        },
        "event-ical": {
            "description": "Where an imported event came from. recurrence_id narrows the claim to one occurrence; without it the note shadows the whole series.",
            "type": "object",
            "properties": {
                "calendar": { "type": "string" },
                "uid": { "type": "string" },
                "recurrence_id": { "type": "string" }
            },
            "required": ["uid"]
        },
        "event-occurrence": {
            "description": "One occurrence. With at, it changes the occurrence the rule generates at that time; with its own start, it is an occurrence the rule does not generate.",
            "type": "object",
            "properties": {
                "at": { "type": "string" },
                "start": { "type": "string" },
                "end": { "type": "string" },
                "finished": { "type": "boolean" },
                "color": { "type": "string" },
                "note": { "type": "string" },
                "name": { "type": "string" },
                "location": { "type": "string" },
                "url": { "type": "string" }
            }
        },
        "event-override": {
            "allOf": [
                { "$ref": "#/definitions/event-occurrence" },
                { "required": ["at"] }
            ]
        },
        "event-instance": {
            "allOf": [
                { "$ref": "#/definitions/event-occurrence" },
                { "required": ["start"] }
            ]
        },
        "event": {
            "description": "An event is a base occurrence (start), a list of occurrences (instances, or its older spelling times), or a rule (repeat) with adjustments to what it generates.",
            "type": "object",
            "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" },
                "finished": { "type": "boolean" },
                "color": { "type": "string" },
                "note": { "type": "string" },
                "name": { "type": "string" },
                "location": { "type": "string" },
                "url": { "type": "string" },
                "repeat": { "$ref": "#/definitions/event-repeat" },
                "exclusions": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "overrides": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-override" }
                },
                "instances": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-instance" }
                },
                "times": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/event-instance" }
                },
                "ical": { "$ref": "#/definitions/event-ical" }
            },
            "anyOf": [
                { "required": ["start"] },
                { "required": ["instances"] },
                { "required": ["times"] }
            ],
            "dependencies": {
                "repeat": ["start"],
                "exclusions": ["repeat"],
                "overrides": ["repeat"]
            }
        },
        "todo-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "todo" }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "in-progress-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "in_progress" }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "waiting-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "waiting" },
                "waiting_for": { "type": "string" },
                "expected_by": { "type": "string" },
                "contact": { "type": "string" },
                "follow_up_at": { "type": "string" }
            },
            "required": ["kind", "waiting_for"],
            "additionalProperties": false
        },
        "blocked-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "blocked" },
                "blocked_by": { "type": "string" }
            },
            "required": ["kind", "blocked_by"],
            "additionalProperties": false
        },
        "on-hold-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "on_hold" },
                "hold_reason": { "type": "string" },
                "review_at": { "type": "string" }
            },
            "required": ["kind", "hold_reason"],
            "additionalProperties": false
        },
        "done-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "done" },
                "completed_at": { "type": "string" },
                "completion_note": { "type": "string" }
            },
            "required": ["kind", "completed_at"],
            "additionalProperties": false
        },
        "canceled-status": {
            "type": "object",
            "properties": {
                "kind": { "const": "canceled" },
                "canceled_at": { "type": "string" },
                "cancel_reason": { "type": "string" }
            },
            "required": ["kind", "canceled_at", "cancel_reason"],
            "additionalProperties": false
        },
        "task-status": {
            "oneOf": [
                { "$ref": "#/definitions/todo-status" },
                { "$ref": "#/definitions/in-progress-status" },
                { "$ref": "#/definitions/waiting-status" },
                { "$ref": "#/definitions/blocked-status" },
                { "$ref": "#/definitions/on-hold-status" },
                { "$ref": "#/definitions/done-status" },
                { "$ref": "#/definitions/canceled-status" }
            ]
        },
        "task": {
            "type": "object",
            "properties": {
                "status": { "$ref": "#/definitions/task-status" },
                "progress": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                },
                "importance": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                },
                "urgency": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                },
                "start_at": { "type": "string" },
                "due_by": { "type": "string" },
                "deadline": { "type": "string" },
                "scheduled_dates": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            },
            "required": ["status", "progress", "importance", "urgency", "scheduled_dates"],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "tags": {
            "oneOf": [
                { "type": "null" },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "events": {
            "oneOf": [
                { "type": "null" },
                {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/definitions/event" }
                }
            ]
        },
        "task": {
            "oneOf": [
                { "type": "null" },
                { "$ref": "#/definitions/task" }
            ]
        }
    }
}
